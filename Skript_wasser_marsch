alias: wasser_marsch
sequence:
  - target:
      entity_id: switch.sd_16_balkon_links_schalter
    action: switch.turn_on
    continue_on_error: true
  - delay:
      hours: 0
      minutes: 2
      seconds: 0
      milliseconds: 0
    continue_on_error: true
  - target:
      entity_id: switch.sd_16_balkon_links_schalter
    action: switch.turn_off
    continue_on_error: true
  - delay:
      hours: 0
      minutes: 0
      seconds: 2
      milliseconds: 0
    continue_on_error: true
  - target:
      entity_id: switch.sd_16_balkon_links_schalter
    action: switch.turn_off
    continue_on_error: true
  - delay:
      hours: 0
      minutes: 0
      seconds: 2
      milliseconds: 0
    continue_on_error: true
  - target:
      entity_id: switch.sd_16_balkon_links_schalter
    action: switch.turn_off
    continue_on_error: true
  - action: notify.mobile_app_pixl
    data:
      title: Balkon Bewässerung abgeschlossen
      message: >
        Die Bewässerung wurde durchgeführt. Aktueller Tankfüllstand: {{
        states('sensor.balkon_wassertank_fullstand') | float(0) | round(0) }} %.
    continue_on_error: true
mode: single
description: ""
